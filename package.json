{
  "name": "trip-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "docs:statecharts": "tsx scripts/statecharts.ts",
    "docs:statecharts:check": "tsx scripts/statecharts.ts --check",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "npm run db:migrate && next build",
    "trip:import": "tsx scripts/import-trip.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nwpr/airport-codes": "^3.0.3",
    "@photostructure/tz-lookup": "^11.8.0",
    "city-timezones": "^1.3.4",
    "countries-and-timezones": "^3.11.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
